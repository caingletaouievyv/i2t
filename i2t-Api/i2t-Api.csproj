<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.*" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
		<PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="9.0.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
		<PackageReference Include="WeCantSpell.Hunspell" Version="6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Dictionaries\" />
		<Folder Include="tessdata\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="tessdata\**\*" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Dictionaries\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
